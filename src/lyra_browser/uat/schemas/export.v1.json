      "type": "integer"
    },
    "step_budget": {
      "title": "Step Budget",
      "type": "integer"
    },
    "tool_calls": {
      "title": "Tool Calls",
      "type": "integer"
    },
    "findings": {
      "title": "Findings",
      "type": "integer"
    },
    "brain_backend": {
      "title": "Brain Backend",
      "type": "string"
    },
    "brain_model": {
