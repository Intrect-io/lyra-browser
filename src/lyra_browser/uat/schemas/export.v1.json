{
  "$defs": {
    "AssertResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "not_evaluated"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "observed": {
          "default": null,
          "title": "Observed"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "expected"
      ],
      "title": "AssertResult",
      "type": "object"
    },
    "ExportStep": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "title": "N",
          "type": "integer"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "url_after": {
          "title": "Url After",
          "type": "string"
        },
        "counted": {
          "title": "Counted",
          "type": "boolean"
        },
        "duration_ms": {
          "default": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "screenshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screenshot"
        }
      },
      "required": [
        "n",
        "tool",
        "args",
        "status",
        "url_after",
        "counted"
      ],
      "title": "ExportStep",
      "type": "object"
    }
