    "task_id",
    "run_id",
    "started_at",
    "finished_at",
    "duration_s",
    "run_status",
    "exit_reason",
    "success",
    "asserts",
    "claimed_outcome",
    "summary",
    "final_url",
    "steps_used",
    "step_budget",
    "tool_calls",
    "findings",
    "brain_backend",
    "brain_model",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "lyra_browser_version",
    "steps",
    "report_json"
