{
  "mcpServers": {
    "lyra": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/claude-plugin/launch.sh",
      "env": {
        "LYRA_BROWSER_CONSENT_CHANNEL": "elicit",
        "LYRA_BROWSER_TRUSTED_ORIGINS": "${user_config.trusted_origins}",
        "LYRA_BROWSER_TRUSTED_SEND_ORIGINS": "${user_config.trusted_send_origins}",
        "LYRA_BROWSER_DENIED_ORIGINS": "${user_config.denied_origins}",
        "LYRA_BROWSER_CONSENT_TIMEOUT": "${user_config.consent_timeout}",
        "LYRA_BROWSER_GUARD": "${user_config.guard}",
        "LYRA_BROWSER_HEADLESS": "${user_config.headless}"
      },
      "timeout": 900000
    }
  }
}
